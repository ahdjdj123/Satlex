function makeDeckOrder(deck) {
  let idxs = VOCAB.map((_, i) => i);
  if (deck !== "all") idxs = idxs.filter((i) => VOCAB[i].tier === deck);
  for (let i = idxs.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [idxs[i], idxs[j]] = [idxs[j], idxs[i]];
  }
  return idxs;
}

// Render the passage with the blank shown as a short line (for the back of card)
function ContextSnippet({ passage }) {
  const parts = passage.split(/_{3,}/g);
  if (parts.length === 1) return <>{passage}</>;
  return (
    <>
      {parts.map((p, i) => (
        <React.Fragment key={i}>
          {p}
          {i < parts.length - 1 && <span className="inline-block border-b border-slate-400 w-12 mx-1" style={{ height: "0.9em" }} />}
        </React.Fragment>
      ))}
    </>
  );
}

