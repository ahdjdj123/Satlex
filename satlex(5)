          <span className="text-sm text-slate-500">{recognizedCount} word{recognizedCount === 1 ? "" : "s"} recognized</span>
        </div>
        <p className="mt-2 text-sm text-slate-500">
          {recognizedCount > 0
            ? "Your Practice pool is ready — head to Practice to drill these words."
            : "Mark words as Recognized in Flashcards to build your Practice pool."}
        </p>
        <button onClick={() => onNavigate(recognizedCount > 0 ? "practice" : "flashcards")}
          className="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-white font-medium text-sm shadow-sm"
          style={{ backgroundColor: "#3478F6" }}>
          {recognizedCount > 0 ? (<><Target className="w-4 h-4" /> Go to Practice</>) : (<><Layers className="w-4 h-4" /> Go to Flashcards</>)}
        </button>
      </div>
    </div>
  );
}

/* ===================================================================
 * SETTINGS VIEW
 * =================================================================== */
function SettingsView({ progress, setProgress, setStreak, setRecog }) {
  const [confirming, setConfirming] = useState(false);

  const resetAll = () => {
    setProgress({ verified: {}, attempts: 0, correct: 0 });
    setRecog({ recognized: {}, studied: 0 });
    setStreak({ count: 1, lastDay: todayKey() });
    setConfirming(false);
  };
  const resetVerified = () => setProgress((p) => ({ ...p, verified: {}, attempts: 0, correct: 0 }));
  const resetRecognized = () => setRecog((r) => ({ recognized: {}, studied: 0 }));

  return (
    <div className="px-8 py-8 max-w-3xl">
      <h1 className="text-3xl font-bold tracking-tight">Settings</h1>
      <p className="mt-1 text-slate-500">Manage your progress and preferences.</p>

      <div className="mt-8 space-y-4">
        <div className="bg-white rounded-2xl border border-slate-200 p-6">
          <h2 className="text-sm font-semibold text-slate-700">Study progress</h2>
          <p className="text-sm text-slate-500 mt-1">
            Verified: {Object.keys(progress.verified).length} · Attempts: {progress.attempts} · Correct: {progress.correct}
          </p>
          <div className="mt-4 flex gap-3 flex-wrap">
            <button onClick={resetVerified}
              className="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Reset verified words & stats
            </button>
            <button onClick={resetRecognized}
              className="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Reset recognized words
            </button>
            {!confirming ? (
              <button onClick={() => setConfirming(true)}
                className="px-4 py-2 rounded-xl border border-red-200 text-sm font-medium text-red-700 hover:bg-red-50">
                Reset everything
              </button>
            ) : (
              <span className="inline-flex items-center gap-2">
                <span className="text-sm text-red-600">Are you sure?</span>
                <button onClick={resetAll} className="px-3 py-1.5 rounded-lg bg-red-600 text-white text-sm font-medium">Yes, reset</button>
                <button onClick={() => setConfirming(false)} className="px-3 py-1.5 rounded-lg border border-slate-200 text-sm font-medium text-slate-600">Cancel</button>
              </span>
            )}
          </div>
        </div>

        <div className="bg-white rounded-2xl border border-slate-200 p-6">
          <h2 className="text-sm font-semibold text-slate-700">About SATLEX</h2>
          <p className="text-sm text-slate-500 mt-1">
            SATLEX is a self-contained vocabulary app with the full {VOCAB.length}-word database (Batches 1–6).
            Progress is stored locally in your browser; nothing is sent to any server.
          </p>
        </div>
      </div>
    </div>
  );
}

