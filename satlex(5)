<style>
  body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #F7F8FA; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  .flip-card {
    perspective: 1000px;
    -webkit-perspective: 1000px;
    perspective-origin: center center;
  }
  /* The flipping layer. 3D Y-axis flip, duration-500. */
  .flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(.45,.05,.25,1.05);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    will-change: transform;
  }
  .flip-inner.flipped { transform: rotateY(180deg); -webkit-transform: rotateY(180deg); }

  /* Faces: backface-hidden so the "wrong side" is invisible during the flip. */
  .flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -moz-backface-visibility: hidden;
    -ms-backface-visibility: hidden;
  }
  .flip-back { transform: rotateY(180deg); -webkit-transform: rotateY(180deg); }

  /* Subtle entrance lift when the card first mounts / changes word. */
  @keyframes flipCardIn {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }
  .flip-card .flip-inner { animation: flipCardIn 0.35s ease-out; }

  /* Front face: clean white with a faint gradient and a soft accent edge. */
  .flip-face-front {
    background:
      radial-gradient(120% 80% at 50% 0%, #ffffff 0%, #f8fafc 60%, #f1f5f9 100%);
  }
  /* Back face: a deeper navy-tinted gradient so the flip is visually obvious. */
  .flip-face-back {
    background:
      radial-gradient(120% 80% at 50% 0%, #eef4ff 0%, #e3ecff 55%, #d8e4ff 100%);
  }

  /* Semantic option button states (SAT Practice). */
  .opt-correct { background-color: #f0fdf4; border-color: #22C55E; color: #15803d; }
  .opt-wrong   { background-color: #fef2f2; border-color: #ef4444; color: #b91c1c; }
  .opt-muted   { background-color: #ffffff; border-color: #e2e8f0; color: #94a3b8; opacity: .72; }
  .opt-idle    { background-color: #ffffff; border-color: #e2e8f0; color: #1e293b; }
  .opt-idle:hover { border-color: #3478F6; background-color: #eff6ff; }

  /* Smooth progress bars. */
  .prog-bar { transition: width 0.3s ease-out; }

  /* Button hover-lift micro-interaction. */
  .btn-lift { transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, background-color 0.18s ease-out; }
  .btn-lift:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 16px -4px rgba(20,43,74,0.18); }
  .btn-lift:active:not(:disabled) { transform: translateY(0); }
  .btn-lift:disabled { opacity: .55; cursor: not-allowed; }

  /* Respect users who prefer reduced motion: no animation at all. */
  @media (prefers-reduced-motion: reduce) {
    .flip-inner { transition: none; animation: none; }
    .flip-card .flip-inner { animation: none; }
    .btn-lift:hover { transform: none; }
    .prog-bar { transition: none; }
  }

  /* ===== Mobile responsive layout =====
     Below md (768px) the navy sidebar becomes a slide-in drawer.
     A sticky top bar with a hamburger appears on mobile only.   */
  .mobile-topbar { display: none; }
  .sidebar-overlay { display: none; }

  @media (max-width: 767px) {
    /* Top bar replaces the persistent sidebar on phones. */
    .mobile-topbar {
      display: flex; position: sticky; top: 0; z-index: 40;
      align-items: center; gap: 0.6rem;
      padding: 0.6rem 0.9rem;
      background: #142B4A; color: #fff;
      box-shadow: 0 1px 0 rgba(0,0,0,0.04);
    }
    .mobile-topbar .brand { font-weight: 600; font-size: 1rem; letter-spacing: -0.01em; }

    /* Sidebar becomes an off-canvas drawer. */
    aside.sidebar-drawer {
      position: fixed; top: 0; left: 0; bottom: 0;
      transform: translateX(-100%); transition: transform 0.28s ease-out;
      z-index: 50; width: 80vw; max-width: 18rem; box-shadow: 0 10px 30px -8px rgba(0,0,0,0.35);
    }
    aside.sidebar-drawer.open { transform: translateX(0); }

    /* Click-away overlay while the drawer is open. */
    .sidebar-overlay.show { display: block; position: fixed; inset: 0; z-index: 45;
      background: rgba(15,23,42,0.45); }

    /* Tighten the page gutters on phones so cards have room. */
    .page-pad { padding-left: 1rem !important; padding-right: 1rem !important; padding-top: 1rem !important; padding-bottom: 1rem !important; }
    /* Override the desktop px-8 gutters on phones (Dashboard, Flashcards, Practice, Settings, FAQ). */
    .px-8 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .py-8 { padding-top: 1rem !important; padding-bottom: 1rem !important; }
    /* Prevent max-w-3xl/5xl from starving very narrow phones — let content breathe. */
    .max-w-5xl, .max-w-3xl { max-width: 100% !important; }
    /* Keep flashcard card height compact on small screens. */
    .flip-card { height: auto !important; min-height: 260px; }
  }

</style>
