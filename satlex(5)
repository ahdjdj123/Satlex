/* ===================================================================
 * DASHBOARD VIEW
 * =================================================================== */
function DashboardView({ progress, recog, streak, onNavigate }) {
  const verifiedCount = Object.keys(progress.verified).length;
  const recognizedCount = Object.keys(recog.recognized).length;
  const total = VOCAB.length;
  const accuracy = progress.attempts > 0 ? Math.round((progress.correct / progress.attempts) * 100) : 0;

  const byTier = useMemo(() => {
    const g = { tier_1: { total: 0, verified: 0 }, tier_2: { total: 0, verified: 0 }, tier_3: { total: 0, verified: 0 } };
    for (const e of VOCAB) {
      if (!g[e.tier]) g[e.tier] = { total: 0, verified: 0 };
      g[e.tier].total += 1;
      if (progress.verified[e.id]) g[e.tier].verified += 1;
    }
    return g;
  }, [progress.verified]);

  return (
    <div className="px-8 py-8 max-w-5xl">
      <div className="flex items-end justify-between gap-4 flex-wrap">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Dashboard</h1>
          <p className="mt-1 text-slate-500">Welcome back — here's where your SAT vocabulary stands today.</p>
        </div>
        <button onClick={() => onNavigate("flashcards")}
          className="btn-lift inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white font-medium shadow-sm"
          style={{ backgroundColor: "#3478F6" }}>
          <Layers className="w-4 h-4" /> Start Flashcards
        </button>
      </div>

      {/* top stat cards — count-up on mount */}
      <div className="mt-8 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {/* Day streak — Amber (streak semantic) */}
        <StatCardCount Icon={Flame} label="Day streak" target={streak} accent="from-amber-400 to-amber-600" />
        {/* Verified — Leaf Green (positive progress) */}
        <StatCard Icon={CheckCircle} label="Verified" value={`${verifiedCount} / ${total}`} accent="from-emerald-500 to-emerald-700" />
        <StatCardCount Icon={BookMarked} label="Recognized" target={recognizedCount} accent="from-blue-500 to-blue-700" />
        {/* Accuracy — Leaf Green when >0 */}
        <StatCardCount Icon={TrendingUp} label="Accuracy" target={accuracy} suffix="%" accent="from-emerald-500 to-emerald-700" />
      </div>

      {/* quick actions */}
      <h2 className="mt-10 text-sm font-semibold text-slate-700">Quick actions</h2>
      <div className="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <QuickAction Icon={Layers} title="Flashcards" desc="Flip cards one by one. Mark words Recognized to unlock Practice."
          onClick={() => onNavigate("flashcards")} accent="#3478F6" />
        <QuickAction Icon={Target} title="SAT Practice" desc="15-question session — Words in Context + Definition Match."
          onClick={() => onNavigate("practice")} accent="#22C55E" />
        <QuickAction Icon={BookOpen} title="Learn" desc="Browse and search the full word database."
          onClick={() => onNavigate("learn")} accent="#3478F6" />
      </div>

      {/* mastery by tier — smooth progress bars */}
      <h2 id="mastery-by-tier" className="mt-10 text-sm font-semibold text-slate-700">Mastery by tier</h2>
      <div className="mt-3 bg-white rounded-2xl border border-slate-200 p-6">
        <div className="space-y-4">
          {Object.entries(byTier).map(([tier, g]) => {
            const pct = g.total > 0 ? Math.round((g.verified / g.total) * 100) : 0;
            return (
              <div key={tier}>
                <div className="flex items-center justify-between text-sm mb-1">
                  <span className="font-medium text-slate-700 capitalize">{tier.replace("_", " ")}</span>
                  <span className="text-slate-500">{g.verified} / {g.total} ({pct}%)</span>
                </div>
                <div className="h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div className="h-full prog-bar rounded-full" style={{ width: `${pct}%`, backgroundColor: "#22C55E" }} />
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* how it works — visual horizontal stepper */}
      <h2 className="mt-10 text-sm font-semibold text-slate-700">How SATLEX works</h2>
      <HowItWorksStepper />
    </div>
  );
}

