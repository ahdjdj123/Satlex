/* ===================================================================
 * FLASHCARDS VIEW — flip-card study, mark Recognized / Not yet
 * =================================================================== */
function FlashcardsView({ recog, setRecog, streak }) {
  const [deck, setDeck] = useState("all"); // all | tier_1 | tier_2 | tier_3
  const [order, setOrder] = useState(() => makeDeckOrder("all"));
  const [pos, setPos] = useState(0);
  const [flipped, setFlipped] = useState(false);
  const [seed, setSeed] = useState(() => Math.random());
  const [session, setSession] = useState({ recognized: 0, notYet: 0 });

  // rebuild the deck when the filter changes
  useEffect(() => {
    setOrder(makeDeckOrder(deck));
    setPos(0); setFlipped(false); setSeed(Math.random());
    setSession({ recognized: 0, notYet: 0 });
  }, [deck]);

  const current = VOCAB[order[pos]] || null;

  // keyboard shortcuts: space/enter flip; R recognized, N not-yet; arrows next/prev
  useEffect(() => {
    const onKey = (e) => {
      if (e.key === " " || e.key === "Enter") { e.preventDefault(); setFlipped((f) => !f); }
      else if (e.key.toLowerCase() === "r" && flipped) { markRecognized(true); }
      else if (e.key.toLowerCase() === "n" && flipped) { markRecognized(false); }
      else if (e.key === "ArrowRight") { goNext(); }
      else if (e.key === "ArrowLeft") { goPrev(); }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  });

  const goNext = () => { setFlipped(false); setPos((i) => (i + 1) % Math.max(order.length, 1)); };
  const goPrev = () => { setFlipped(false); setPos((i) => (i - 1 + order.length) % Math.max(order.length, 1)); };

  const markRecognized = (yes) => {
    if (!current) return;
    setRecog((r) => {
      const recognized = { ...r.recognized };
      if (yes) recognized[current.id] = true; else delete recognized[current.id];
      return { ...r, recognized, studied: (r.studied || 0) + 1 };
    });
    setSession((s) => ({ recognized: s.recognized + (yes ? 1 : 0), notYet: s.notYet + (yes ? 0 : 1) }));
    // advance after a short beat so the user sees the color
    setTimeout(() => { setFlipped(false); setPos((i) => (i + 1) % Math.max(order.length, 1)); }, 160);
  };

  const shuffleDeck = () => {
    setOrder(makeDeckOrder(deck));
    setPos(0); setFlipped(false); setSeed(Math.random());
    setSession({ recognized: 0, notYet: 0 });
  };

  const recognizedInDeck = useMemo(
    () => order.filter((i) => recog.recognized[VOCAB[i].id]).length,
    [order, recog.recognized]
  );

  if (!current) {
    return <div className="px-8 py-16 text-slate-500">No vocab data loaded.</div>;
  }

  return (
    <div className="px-8 py-8 max-w-3xl">
      <div className="flex items-end justify-between gap-4 flex-wrap">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Flashcards</h1>
          <p className="mt-1 text-slate-500">Flip a card, then mark whether you recognize the word. Recognized words unlock Practice.</p>
        </div>
      </div>

      {/* deck filter */}
      <div className="mt-6 flex flex-wrap items-center gap-3">
        <div className="inline-flex rounded-xl border border-slate-200 bg-white overflow-hidden">
          {["all","tier_1","tier_2","tier_3"].map((t) => (
            <button key={t} onClick={() => setDeck(t)}
              className={`px-3.5 py-2.5 text-sm font-medium ${deck === t ? "bg-blue-50 text-blue-700" : "text-slate-600 hover:bg-slate-50"}`}>
              {t === "all" ? "All tiers" : t === "tier_1" ? "Tier 1" : t === "tier_2" ? "Tier 2" : "Tier 3"}
            </button>
          ))}
        </div>
        <button onClick={shuffleDeck}
          className="inline-flex items-center gap-2 px-3 py-2.5 rounded-xl border border-slate-200 bg-white text-sm font-medium text-slate-600 hover:bg-slate-50">
          <RefreshCw className="w-4 h-4" /> Shuffle
        </button>
        <div className="ml-auto text-sm text-slate-400 flex items-center gap-3">
          <span>Card {pos + 1} / {order.length}</span>
          <span className="text-slate-300">|</span>
          <span style={{ color: "#16a34a" }}>Recognized: {session.recognized}</span>
          <span className="text-slate-300">|</span>
          <span style={{ color: "#d97706" }}>Not yet: {session.notYet}</span>
        </div>
      </div>

      {/* recognized-in-deck progress — Leaf Green = positive */}
      <div className="mt-3 flex items-center gap-2 text-xs text-slate-500">
        <span className="font-medium">{recognizedInDeck} / {order.length} recognized in this deck</span>
        <span className="flex-1 h-1.5 bg-slate-200 rounded-full overflow-hidden">
          <span className="prog-bar block h-full rounded-full" style={{ width: `${order.length ? (recognizedInDeck / order.length) * 100 : 0}%`, backgroundColor: "#22C55E" }} />
        </span>
      </div>

      {/* the flip card */}
      <div className="mt-6 flip-card" style={{ height: "340px" }}>
        <div key={current.id} className={`flip-inner ${flipped ? "flipped" : ""}`} onClick={() => setFlipped((f) => !f)}>
          {/* FRONT */}
          <div className="flip-face flip-face-front rounded-2xl border border-slate-200 shadow-sm flex flex-col items-center justify-center p-8 cursor-pointer">
            <div className="flex items-center gap-2 mb-4">
              <TierBadge tier={current.tier} />
              <span className="text-xs text-slate-400">{current.partOfSpeech}</span>
            </div>
            <div className="text-4xl font-bold tracking-tight text-slate-900">{current.entry}</div>
            <div className="mt-6 inline-flex items-center gap-1.5 text-sm font-medium" style={{ color: "#3478F6" }}>
              <Eye className="w-4 h-4" /> Tap to reveal definition
            </div>
            {recog.recognized[current.id] && (
              <div className="mt-3 text-xs text-emerald-600 inline-flex items-center gap-1">
                <CheckCircle className="w-3.5 h-3.5" /> recognized
              </div>
            )}
          </div>
          {/* BACK */}
          <div className="flip-face flip-back flip-face-back rounded-2xl border border-blue-300 shadow-sm flex flex-col p-7 cursor-pointer overflow-auto">
            <div className="flex items-center gap-2 mb-2">
              <TierBadge tier={current.tier} />
              <span className="text-xs text-slate-500">{current.partOfSpeech}</span>
              <span className="ml-auto text-xs text-slate-400 inline-flex items-center gap-1">
                <EyeOff className="w-3.5 h-3.5" /> tap to flip back
              </span>
            </div>
            <div className="text-xl font-bold text-slate-900">{current.entry}</div>
            <p className="mt-2 text-sm text-slate-800 leading-relaxed">{current.definition}</p>
            {current.secondaryMeaning && (
              <p className="mt-2 text-xs text-slate-600 leading-relaxed">
                <span className="font-semibold text-slate-700">Also: </span>{current.secondaryMeaning}
              </p>
            )}
            <div className="mt-3 rounded-lg bg-white/70 border border-blue-200 p-3">
              <span className="text-[11px] font-semibold uppercase tracking-wider" style={{ color: "#3478F6" }}>In context</span>
              <p className="mt-1 text-sm text-slate-700 leading-relaxed"><ContextSnippet passage={current.passage} /></p>
            </div>
          </div>
        </div>
      </div>

      {/* actions */}
      <div className="mt-6 flex items-center justify-between gap-3">
        <button onClick={goPrev}
          className="btn-lift inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
          <ArrowLeft className="w-4 h-4" /> Prev
        </button>
        <div className="flex items-center gap-3">
          <button onClick={() => markRecognized(false)} disabled={!flipped}
            className={`btn-lift inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border text-sm font-medium
              ${flipped ? "text-white" : "border-slate-200 text-slate-300 bg-slate-50 cursor-not-allowed"}`}
            style={flipped ? { backgroundColor: "#F59E0B", borderColor: "#F59E0B" } : undefined}>
            <Minus className="w-4 h-4" /> Not yet
          </button>
          <button onClick={() => markRecognized(true)} disabled={!flipped}
            className={`btn-lift inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium shadow-sm
              ${flipped ? "text-white" : "bg-slate-100 text-slate-300 cursor-not-allowed"}`}
            style={flipped ? { backgroundColor: "#22C55E" } : undefined}>
            <CheckCircle2 className="w-4 h-4" /> Recognized
          </button>
        </div>
        <button onClick={goNext}
          className="btn-lift inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
          Next <ArrowRight className="w-4 h-4" />
        </button>
      </div>
      <p className="mt-3 text-center text-xs text-slate-400">
