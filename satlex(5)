/* ===================================================================
 * Shared helpers
 * =================================================================== */
function PassageText({ passage }) {
  const parts = passage.split(/_{3,}/g);
  if (parts.length === 1) return <p className="text-lg leading-relaxed text-slate-800">{passage}</p>;
  return (
    <p className="text-lg leading-relaxed text-slate-800">
      {parts.map((p, i) => (
        <React.Fragment key={i}>{p}{i < parts.length - 1 && <Blank />}</React.Fragment>
      ))}
    </p>
  );
}

function Blank() {
  return <span aria-label="blank" className="border-b-2 border-gray-400 w-24 inline-block mx-1" style={{ height: "1.1em", verticalAlign: "baseline" }} />;
}

// Semantic option classes — Leaf Green for correct, muted Red for wrong.
// (Tailwind fallbacks kept for older build caches; the CSS .opt-* classes also apply.)
function optionClasses(state) {
  switch (state) {
    case "correct": return "opt-correct border-2";
    case "wrong":   return "opt-wrong border-2";
    case "muted":   return "opt-muted";
    default:        return "opt-idle hover:-translate-y-0.5 hover:shadow-md";
  }
}

function seededShuffle(arr, seed) {
  const a = arr.slice();
  let s = Math.floor(seed * 0xffffffff) >>> 0;
  const rand = () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* ===================================================================
 * useCountUp — animates a number from 0 to `target` over `duration` ms.
 * Uses requestAnimationFrame with an ease-out curve; respects reduced motion.
 * =================================================================== */
function useCountUp(target, duration = 900) {
  const [val, setVal] = useState(0);
  useEffect(() => {
    if (typeof target !== "number" || !isFinite(target) || target === 0) {
      setVal(0); return;
    }
    const reduce = (typeof window !== "undefined" &&
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
    if (reduce) { setVal(target); return; }
    let raf; const start = performance.now();
    const tick = (now) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      setVal(Math.round(eased * target));
      if (t < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [target, duration]);
  return val;
}

/* ===================================================================
 * Definition-Match distractors — pulled from the curated SAT DB only.
 * For a target word, returns 3 definitions from OTHER words (preferring
 * the same part of speech so the wrong definitions are plausible).
 * Never random non-SAT words.
 * =================================================================== */
function pickDefDistractors(target, pool, count = 3, seed = Math.random()) {
  const samePOS = pool.filter((e) => e.id !== target.id && e.partOfSpeech === target.partOfSpeech && e.definition);
  const others = pool.filter((e) => e.id !== target.id && e.partOfSpeech !== target.partOfSpeech && e.definition);
  const candidates = samePOS.length >= count ? samePOS : samePOS.concat(others);
  const shuffled = seededShuffle(candidates, seed);
  return shuffled.slice(0, count).map((e) => e.definition);
}

