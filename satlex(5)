/* ===================================================================
 * SAT PRACTICE — 15-question session from the 496-word curated SAT DB.
 * Alternates Type A (Words in Context) and Type B (Definition Match).
 * Distractors for both types come from the curated SAT database only.
 * =================================================================== */
const SESSION_SIZE = 15;

function PracticeView({ progress, setProgress, setStreak, streak }) {
  // Build a fresh 15-question session: a shuffled slice of the 496-word pool.
  // Each question carries a `type` ("context" | "definition") that alternates.
  const [session, setSession] = useState(() => buildSession(SESSION_SIZE));
  const [pos, setPos] = useState(0);
  const [selected, setSelected] = useState(null);   // the option the user clicked
  const [answered, setAnswered] = useState(false);
  const [seed, setSeed] = useState(() => Math.random());
  const [sessionStats, setSessionStats] = useState({ correct: 0, total: 0 });
  const [finished, setFinished] = useState(false);

  const current = session[pos] || null;

  // Build the 4 options, freshly shuffled per question.
  // Type A: correctAnswer + 3 curated distractors (word forms).
  // Type B: correct definition + 3 definitions from other SAT words (same POS preferred).
  const options = useMemo(() => {
    if (!current) return [];
    if (current.type === "definition") {
      const all = [current.correctAnswer, ...current.defDistractors];
      return seededShuffle(all, seed);
    }
    // Type A: distractors live on the session item (curated SAT words).
    const all = [current.correctAnswer, ...(current.distractors || current.word.distractors || [])];
    return seededShuffle(all, seed);
  }, [current, seed]);

  useEffect(() => { setSelected(null); setAnswered(false); }, [pos, seed]);

  const handleSelect = useCallback((opt) => {
    if (answered || !current) return;
    setSelected(opt);
    setAnswered(true);
    const isCorrect = opt === current.correctAnswer;
    const wid = current.word.id;
    setProgress((p) => ({
      ...p,
      attempts: p.attempts + 1,
      correct: p.correct + (isCorrect ? 1 : 0),
      verified: { ...p.verified, ...(isCorrect ? { [wid]: true } : {}) },
    }));
    setSessionStats((s) => ({ correct: s.correct + (isCorrect ? 1 : 0), total: s.total + 1 }));
    setStreak((s) => (s.lastDay === todayKey() ? s : { count: 1, lastDay: todayKey() }));
  }, [answered, current, setProgress, setStreak]);

  const handleNext = useCallback(() => {
    if (pos + 1 >= session.length) { setFinished(true); return; }
    setPos((i) => i + 1);
    setSeed(Math.random());
  }, [pos, session.length]);

  const handleRestart = useCallback(() => {
    setSession(buildSession(SESSION_SIZE));
    setPos(0); setSessionStats({ correct: 0, total: 0 }); setSeed(Math.random());
    setSelected(null); setAnswered(false); setFinished(false);
  }, []);

  // ---- Session-complete screen ----
  if (finished) {
    const pct = sessionStats.total ? Math.round((sessionStats.correct / sessionStats.total) * 100) : 0;
    return (
      <div className="px-8 py-12 max-w-2xl mx-auto">
        <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 text-center">
          <div className="mx-auto w-14 h-14 rounded-full flex items-center justify-center"
            style={{ backgroundColor: pct >= 70 ? "#f0fdf4" : "#fffbeb" }}>
            {pct >= 70
              ? <Trophy className="w-7 h-7" style={{ color: "#16a34a" }} />
              : <Award className="w-7 h-7" style={{ color: "#d97706" }} />}
          </div>
          <h2 className="mt-4 text-2xl font-bold text-slate-900">Session complete</h2>
          <p className="mt-1 text-slate-500">You answered {sessionStats.total} of {SESSION_SIZE} questions.</p>
          <div className="mt-6 grid grid-cols-2 gap-4">
            <div className="rounded-xl border border-slate-200 p-4">
              <p className="text-3xl font-bold" style={{ color: "#22C55E" }}>{sessionStats.correct}</p>
              <p className="text-sm text-slate-500 mt-0.5">Correct</p>
            </div>
            <div className="rounded-xl border border-slate-200 p-4">
              <p className="text-3xl font-bold text-slate-900">{pct}%</p>
              <p className="text-sm text-slate-500 mt-0.5">Accuracy</p>
            </div>
          </div>
          <button onClick={handleRestart}
            className="btn-lift mt-7 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-medium shadow-sm"
            style={{ backgroundColor: "#3478F6" }}>
            <RotateCcw className="w-4 h-4" /> New 15-question session
          </button>
        </div>
      </div>
    );
  }

  if (!current) {
    return <div className="px-8 py-16 text-slate-500">No vocab data loaded.</div>;
  }

  const isCorrect = selected === current.correctAnswer;
  const isTypeA = current.type === "context";

  // Session progress bar (Leaf Green = positive progress).
  const sessionPct = Math.round((pos / session.length) * 100);

  return (
    <div className="flex flex-col min-h-screen">
      <header className="px-8 py-4 max-w-3xl mx-auto w-full">
        <div className="flex items-center justify-between text-sm">
          <span className="text-slate-500">Question {pos + 1} / {session.length}</span>
          <span className="inline-flex items-center gap-1.5 font-medium" style={{ color: "#22C55E" }}>
            <CheckCircle className="w-4 h-4" /> {sessionStats.correct} / {sessionStats.total} correct
          </span>
        </div>
        <div className="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
          <div className="h-full prog-bar rounded-full" style={{ width: `${sessionPct}%`, backgroundColor: "#22C55E" }} />
        </div>
      </header>

      <main className="flex-1 w-full max-w-3xl mx-auto px-8 py-6 flex flex-col">
        <span className="text-xs font-semibold uppercase tracking-wider" style={{ color: "#3478F6" }}>
          {isTypeA ? "Words in Context" : "Definition Match"}
        </span>

        <AnimatePresence mode="wait">
          <motion.div key={current.id + ":" + pos}
            initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }} transition={{ duration: 0.3 }}
            className="mt-3 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
            <div className="flex items-center gap-2 mb-3">
              <span className="text-xs font-medium px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 uppercase tracking-wide">
                {isTypeA ? "Words in Context" : "Definition Match"}
              </span>
              <span className="text-xs text-slate-400">{current.word.partOfSpeech}</span>
              {progress.verified[current.word.id] && (
                <span className="text-xs inline-flex items-center gap-1 ml-auto" style={{ color: "#16a34a" }}>
                  <CheckCircle className="w-3.5 h-3.5" /> previously verified
                </span>
              )}
            </div>

            {/* Type A: passage with a blank. Type B: prompt the target word. */}
            {isTypeA ? (
              <PassageText passage={current.passage || current.word.passage} />
            ) : (
              <div className="text-center py-2">
                <p className="text-sm text-slate-500">Which of the following is the most accurate definition?</p>
                <p className="mt-2 text-4xl font-bold tracking-tight text-slate-900">{current.word.entry}</p>
              </div>
            )}

            <div className="mt-6 grid grid-cols-1 gap-3">
              {options.map((opt) => {
                const isThisCorrect = opt === current.correctAnswer;
                const isThisSelected = opt === selected;
                let state = "idle";
                if (answered) { if (isThisCorrect) state = "correct"; else if (isThisSelected) state = "wrong"; else state = "muted"; }
                return (
                  <button key={opt} onClick={() => handleSelect(opt)} disabled={answered}
                    className={`flex items-center justify-between px-4 py-3 rounded-xl border text-left ${optionClasses(state)}`}>
                    <span className="font-medium">{opt}</span>
                    {answered && isThisCorrect && <CheckCircle2 className="w-5 h-5" style={{ color: "#22C55E" }} />}
                    {answered && isThisSelected && !isThisCorrect && <XCircle className="w-5 h-5 text-red-500" />}
                  </button>
                );
              })}
            </div>

            <AnimatePresence initial={false}>
              {answered && (
                <motion.div key="explanation"
                  initial={{ opacity: 0, height: 0, marginTop: 0 }} animate={{ opacity: 1, height: "auto", marginTop: 24 }} exit={{ opacity: 0, height: 0, marginTop: 0 }} transition={{ duration: 0.3, ease: "easeOut" }}
                  className="overflow-hidden">
                  <div className="rounded-xl p-4 border"
                    style={isCorrect
                      ? { backgroundColor: "#f0fdf4", borderColor: "#22C55E" }
                      : { backgroundColor: "#fef2f2", borderColor: "#ef4444" }}>
                    <p className="text-sm font-semibold mb-1" style={isCorrect ? { color: "#16a34a" } : { color: "#b91c1c" }}>
                      {isCorrect ? "Correct" : "Not quite"}
                    </p>
                    <p className="text-sm text-slate-700 leading-relaxed">{current.explanation || current.word.explanation}</p>
                  </div>
                </motion.div>
              )}
            </AnimatePresence>
          </motion.div>
        </AnimatePresence>

        <div className="mt-6 flex justify-between items-center">
          <button onClick={handleRestart}
            className="btn-lift inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
            <RotateCcw className="w-3.5 h-3.5" /> Restart
          </button>
          <motion.button onClick={handleNext} whileTap={{ scale: 0.97 }}
            className="btn-lift inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-medium shadow-sm"
            style={{ backgroundColor: "#3478F6" }}>
            {pos + 1 >= session.length ? "Finish" : "Next Word"} <ArrowRight className="w-4 h-4" />
          </motion.button>
        </div>
      </main>
    </div>
  );
}

// Build a 15-question session.
// Type A (Words in Context) pulls from the curated 60-question sentence bank
//   (vocabData) — each has a hand-written SAT passage with a blank and curated
//   SAT-DB distractors. Type B (Definition Match) pulls a fresh word from the
//   496-word VOCAB pool and builds definition distractors from other SAT words.
// Alternates A/B; both use curated SAT distractors only — no random words.
function buildSession(size) {
  if (!VOCAB.length) return [];
  const half = Math.ceil(size / 2); // number of Type A (odd positions)
  // Type A: shuffle the 60 curated sentence questions, take `half`.
  const ctxPool = vocabData && vocabData.length
    ? seededShuffle(vocabData.slice(), Math.random()).slice(0, Math.min(half, vocabData.length))
    : [];
  // Type B: shuffle the 496-word pool, take the rest.
  const defPool = seededShuffle(VOCAB.slice(), Math.random()).slice(0, Math.min(size - ctxPool.length, VOCAB.length));

  const session = [];
  for (let i = 0; i < size; i++) {
    if (i % 2 === 0 && ctxPool.length) {
      // Type A — curated Words-in-Context sentence question.
      const q = ctxPool.shift();
      // Find the matching word record so the verified-bookkeeping + partOfSpeech
      // display work. Fall back to a stub if not found.
      const word = VOCAB.find((v) => v.entry && v.entry.toLowerCase() === q.entry.toLowerCase())
        || { id: q.id, entry: q.entry, partOfSpeech: "", tier: "tier_1", explanation: q.explanation };
      session.push({
        id: q.id + ":ctx",
        word,
        type: "context",
        correctAnswer: q.correctAnswer,
        distractors: q.distractors || [],
        explanation: q.explanation,
        passage: q.passage,
      });
    } else if (defPool.length) {
      // Type B — Definition Match.
      const word = defPool.shift();
      const defDistractors = pickDefDistractors(word, VOCAB, 3, Math.random());
      session.push({
        id: word.id + ":def",
        word,
        type: "definition",
        correctAnswer: word.definition,
        defDistractors,
      });
    }
  }
  return session;
}


