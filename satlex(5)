const VOCAB = (window.SATLEX_VOCAB || []);
const NAVY = "#0d2137";

/* ===================================================================
 * Persistence — verified words, recognized words, streak (localStorage)
 * =================================================================== */
const LS_KEY = "satlex_progress_v1";        // { verified, attempts, correct }
const RECOG_KEY = "satlex_recognized_v1";    // { recognized: { id: true }, studied: 0 }
const STREAK_KEY = "satlex_streak_v1";        // { count, lastDay }
const ACTIVITY_KEY = "satlex_activity_v1";   // [ { day, verified, studied } ]

function loadProgress() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return { verified: {}, attempts: 0, correct: 0 };
    const p = JSON.parse(raw);
    return { verified: p.verified || {}, attempts: p.attempts || 0, correct: p.correct || 0 };
  } catch (e) { return { verified: {}, attempts: 0, correct: 0 }; }
}
function saveProgress(p) { try { localStorage.setItem(LS_KEY, JSON.stringify(p)); } catch (e) {} }

function loadRecognized() {
  try {
    const raw = localStorage.getItem(RECOG_KEY);
    if (!raw) return { recognized: {}, studied: 0 };
    const r = JSON.parse(raw);
    return { recognized: r.recognized || {}, studied: r.studied || 0 };
  } catch (e) { return { recognized: {}, studied: 0 }; }
}
function saveRecognized(r) { try { localStorage.setItem(RECOG_KEY, JSON.stringify(r)); } catch (e) {} }

function loadActivity() {
  try { return JSON.parse(localStorage.getItem(ACTIVITY_KEY) || "[]"); }
  catch (e) { return []; }
}
function saveActivity(a) { try { localStorage.setItem(ACTIVITY_KEY, JSON.stringify(a.slice(-60))); } catch (e) {} }

function loadStreak() {
  try {
    const raw = localStorage.getItem(STREAK_KEY);
    if (!raw) return { count: 1, lastDay: todayKey() };
    const s = JSON.parse(raw);
    if (s.lastDay !== todayKey()) {
      const yesterday = dayKey(-1);
      const count = (s.lastDay === yesterday) ? (s.count + 1) : 1;
      return { count, lastDay: todayKey() };
    }
    return s;
  } catch (e) { return { count: 1, lastDay: todayKey() }; }
}
function saveStreak(s) { try { localStorage.setItem(STREAK_KEY, JSON.stringify(s)); } catch (e) {} }

function todayKey() { return dayKey(0); }
function dayKey(offsetDays) {
  const d = new Date();
  d.setDate(d.getDate() + offsetDays);
  return d.toISOString().slice(0, 10);
}

/* ===================================================================
 * App shell — navy sidebar with exactly 5 main buttons
 * =================================================================== */
function App() {
  const [view, setView] = useState("dashboard");
  const [progress, setProgress] = useState(loadProgress);
  const [recog, setRecog] = useState(loadRecognized);
  const [streak, setStreak] = useState(loadStreak);
  const [menuOpen, setMenuOpen] = useState(false); // mobile drawer

  useEffect(() => { saveProgress(progress); }, [progress]);
  useEffect(() => { saveRecognized(recog); }, [recog]);
  useEffect(() => { saveStreak(streak); }, [streak]);

  const navigate = useCallback((v) => { setView(v); setMenuOpen(false); }, []);

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col md:flex-row">
